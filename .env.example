# ========================================================
# Portfolio Backend Environment Variables Template
# Copy this file to .env and replace the values with your credentials
# DO NOT COMMIT THE ACTUAL .env FILE TO GITHUB
# ========================================================

# Server Port (Render and Railway assign PORT automatically in production)
PORT=5000

# Node Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas: Database > Connect > Drivers > Node.js
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/portfolio?retryWrites=true&w=majority

# Secret key for signing JWT tokens (generate a long, random string)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_characters

# Default Admin Credentials for automatic initial setup
# The server will automatically create this admin on first start if no admin exists
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=YourSecureAdminPassword123!

# Allowed Frontend Origins for CORS (comma-separated, without trailing slashes)
# In development:
CORS_ORIGIN=http://localhost:5173,http://localhost:3000
# In production (example):
# CORS_ORIGIN=https://arun-portfolio.vercel.app,http://localhost:5173
